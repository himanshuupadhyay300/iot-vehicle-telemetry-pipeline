# Copy to .env and fill in. NEVER commit the real .env file.
# Local mode needs none of these. They are only used for the optional Azure stages.

# --- Pipeline overrides (optional) ---
TELEMETRY_STORAGE_FORMAT=parquet        # parquet | delta
TELEMETRY_BASE_PATH=output/lakehouse
TELEMETRY_INPUT_PATH=data/sample
TELEMETRY_REPORTS_PATH=output/reports
TELEMETRY_LOG_LEVEL=INFO

# --- Azure Event Hubs (optional streaming stage) ---
EVENTHUB_NAMESPACE=<your-namespace>
EVENTHUB_NAME=vehicle-telemetry
# Prefer Azure Key Vault / Databricks secret scope in real deployments:
EVENTHUB_CONNECTION_STRING=<paste-from-key-vault-never-commit>
