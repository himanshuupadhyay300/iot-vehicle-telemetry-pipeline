{
  "name": "telemetry-medallion-job",
  "description": "TEMPLATE (Jobs API 2.1 shape, not deployed). Same notebook as ADF; use either ADF or this job schedule, not both.",
  "git_source": {
    "git_url": "https://github.com/<your-username>/iot-vehicle-telemetry-pipeline",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "job_clusters": [
    {
      "job_cluster_key": "etl",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 2,
        "spark_conf": { "spark.sql.shuffle.partitions": "8" }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "bronze_silver_gold",
      "job_cluster_key": "etl",
      "notebook_task": {
        "notebook_path": "notebooks/01_run_medallion_pipeline",
        "source": "GIT",
        "base_parameters": { "storage_account": "<storage_account>", "stage": "all" }
      },
      "max_retries": 2
    }
  ],
  "schedule": { "quartz_cron_expression": "0 0 * * * ?", "timezone_id": "UTC", "pause_status": "PAUSED" }
}
